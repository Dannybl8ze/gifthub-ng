# GiftHub NG environment template
# Copy this file to .env.local and fill in real values when wiring Supabase.
# Leaving these blank is fine — the app falls back to in-memory mock data.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional: server-only key for admin actions (do NOT prefix with NEXT_PUBLIC_)
SUPABASE_SERVICE_ROLE_KEY=

# Admin sign-in for /admin. Until all three are set, /admin stays locked.
# Generate the hash and secret with: node scripts/admin-credentials.mjs
ADMIN_EMAIL=
ADMIN_PASSWORD_HASH=
ADMIN_SESSION_SECRET=

# Gift assistant (the chat widget on every page).
# With none of these set it runs in "simple matching" mode: no AI, no cost.
# Set ONE credential option below to switch it to Amazon Bedrock.
#
# Option A: a Bedrock API key (Bedrock console > API keys)
BEDROCK_API_KEY=
# Option B: IAM access keys for a user/role allowed to call bedrock:InvokeModel
BEDROCK_ACCESS_KEY_ID=
BEDROCK_SECRET_ACCESS_KEY=
BEDROCK_SESSION_TOKEN=
# Optional. Defaults shown. The model ID must be one your Bedrock account can use in this region.
BEDROCK_REGION=us-east-1
BEDROCK_MODEL_ID=us.amazon.nova-lite-v1:0
