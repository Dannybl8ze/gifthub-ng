# GiftHub NG environment template
# Copy this file to .env.local and fill in real values when wiring Supabase.
# Leaving these blank is fine — the app falls back to in-memory mock data.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional: server-only key for admin actions (do NOT prefix with NEXT_PUBLIC_)
SUPABASE_SERVICE_ROLE_KEY=

# Admin sign-in for /admin. Until all three are set, /admin stays locked.
# Generate the hash and secret with: node scripts/admin-credentials.mjs
ADMIN_EMAIL=
ADMIN_PASSWORD_HASH=
ADMIN_SESSION_SECRET=
