# GiftHub NG environment template
# Copy this file to .env.local and fill in real values when wiring Supabase.
# Leaving these blank is fine — the app falls back to in-memory mock data.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional: server-only key for admin actions (do NOT prefix with NEXT_PUBLIC_)
SUPABASE_SERVICE_ROLE_KEY=
